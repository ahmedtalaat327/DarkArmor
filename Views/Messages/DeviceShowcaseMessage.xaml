<UserControl x:Class="DarkArmor.Views.Messages.DeviceShowcaseMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DarkArmor.Views.Messages"
             mc:Ignorable="d" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DesignHeight="1000" d:DesignWidth="1000">

    <!-- Translucent dark screen overlay layer mask -->
    <Grid Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- Main Modal Frame Container - Styled with deep subtle purple matching your ecosystem theme -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                MaxWidth="800"
                MaxHeight="450" 
                MinWidth="550"
                MinHeight="400"
                CornerRadius="12" 
                Background="#1E1A2F"
                BorderBrush="#00E5FF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.4" Color="#120F1D"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- Content Dashboard Body Layer Pane - Slightly lighter purple tint panel -->
                <Border Background="#26213B" 
                        BorderBrush="#3D355E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="16,16,16,8">

                    <StackPanel Margin="24">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vector Icon placeholder matching modern dashboard components -->
                            <ui:SymbolIcon Symbol="Info24" Filled="True" FontSize="26" Foreground="#00E5FF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontSize="18" Foreground="#FFFFFF" FontWeight="SemiBold" Text="Device Details" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Foreground="#D5D0EA" FontSize="14" FontWeight="Medium" Text="Theme" />
                    </StackPanel>
                </Border>

                <!-- Action Control Layer Tray Elements Footer Layout -->
                <Grid Grid.Row="1" Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clean, flat buttons styled uniformly without high-contrast custom properties -->
                    <ui:Button Grid.Column="0" 
                               Appearance="Primary"
                               Margin="0,0,8,0" 
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch"
                               Content="Update"/>

                    <ui:Button Grid.Column="1" 
                               Appearance="Secondary"
                               Margin="8,0,0,0"  
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch"
                               Content="Revert" 
                               Click="Button_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
